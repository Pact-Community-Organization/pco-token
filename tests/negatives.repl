(commit-tx)

(env-data
  { "cl": { "keys": ["c0ffee000000000000000000000000000000000000000000000000000c0ffee0"], "pred": "keys-all" }
  , "bad": { "keys": ["badc0de00000000000000000000000000000000000000000000000000badc0de"], "pred": "keys-all" } })

