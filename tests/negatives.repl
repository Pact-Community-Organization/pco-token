(expect-failure "internal only" "require-capability: not granted"
  (free.pco-claim.grant-internal
    "k:c0ffee000000000000000000000000000000000000000000000000000c0ffee0"
    (read-keyset 'cl) 1.0 "x"))
(rollback-tx)

;; --- pool escrow (module guard): nobody outside pco-claim, and no
;;     INSUFFICIENT gov quorum, can move pool funds. A foreign spend falls through
;;     to acquireModuleAdmin(pco-claim) -> gov keyset (keys-2). (The FULL keys-2
;;     quorum retains a disclosed module-admin spend path — proven positively in
;;     pco-claim.repl; it crosses no tier, since gov can sweep or upgrade anyway.)
(begin-tx "pool: outside transfer-create rejected (module guard)")
(env-data { "thief": { "keys": ["thief-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "thief-key"
            , "caps": [(free.pco.TRANSFER (free.pco-claim.pool-account) "whale" 1.0)] } ])
(expect-failure "module guard holds against outsiders" "Keyset failure"
  (free.pco.transfer-create (free.pco-claim.pool-account) "whale" (read-keyset 'thief) 1.0))
(rollback-tx)

(begin-tx "pool: an insufficient gov quorum (1 of keys-2) cannot debit the pool")
(env-sigs [ { "key": "ledger-a", "caps": [(free.pco.TRANSFER (free.pco-claim.pool-account) "whale" 1.0)] } ])
(env-data { "x": { "keys": ["xk"], "pred": "keys-all" } })
(expect-failure "module admin needs the full keys-2 quorum" "Keyset failure"
  (free.pco.transfer-create (free.pco-claim.pool-account) "whale" (read-keyset 'x) 1.0))
(rollback-tx)

;; --- sweep ---
(begin-tx "sweep: while open rejected")
(env-keys ["ledger-a", "ledger-b"])
(free.pco-claim.set-open true)
(expect-failure "close before sweeping" "close claiming before sweeping"
  (free.pco-claim.sweep-pool "r:free.pco-gov" (keyset-ref-guard "free.pco-gov")))
(rollback-tx)

(begin-tx "sweep: non-admin rejected")
(env-keys ["ledger-a", "ledger-b"])
(free.pco-claim.set-open false)
(env-data { "att": { "keys": ["att-key"], "pred": "keys-all" } })
(env-keys ["att-key"])
(expect-failure "non-admin cannot sweep" "Keyset failure"
  (free.pco-claim.sweep-pool "att-sink" (read-keyset 'att)))
(rollback-tx)

;; ===========================================================================
;; MODULE `pco-gas-station`
;; ===========================================================================

(begin-tx "fund the station for withdraw negatives")
(test-capability (coin.COINBASE))
(coin.coinbase (free.pco-gas-station.station-account)
  (free.pco-gas-station.create-gas-payer-guard) 3.0)
;; Every case below is about the allowlist, the ceilings or the envelope keys.
;; The sponsorship check binds the transaction's gas payer to the station FIRST,
;; so without this the cases would all abort on the sender and pass for the
;; wrong reason - proving nothing about the branch each one names.
(env-chain-data { "sender": (free.pco-gas-station.station-account) })
(commit-tx)

(begin-tx "GAS_PAYER: cont transaction refused")
(env-data { "tx-type": "cont", "exec-code": ["(free.pco-claim.claim \"r1\" \"k:x\" g \"c\")"] })
(env-chain-data { "gas-price": 0.0000001, "gas-limit": 3000 })
(expect-failure "exec only" "exec transactions only"
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.0000001)))
(rollback-tx)

(begin-tx "GAS_PAYER: multi-call refused")
(env-data { "tx-type": "exec"
          , "exec-code": ["(free.pco-claim.claim \"r1\" \"k:x\" g \"c\")" "(coin.transfer \"a\" \"b\" 1.0)"] })
(env-chain-data { "gas-price": 0.0000001, "gas-limit": 3000 })
(expect-failure "single call only" "exactly one call"
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.0000001)))
(rollback-tx)

(begin-tx "GAS_PAYER: unlisted call refused")
(env-data { "tx-type": "exec", "exec-code": ["(coin.transfer \"a\" \"b\" 1.0)"] })
(env-chain-data { "gas-price": 0.0000001, "gas-limit": 3000 })
(expect-failure "not sponsored" "not a sponsored call"
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.0000001)))
(rollback-tx)

(begin-tx "GAS_PAYER: prefix-boundary attack refused")
(env-data { "tx-type": "exec", "exec-code": ["(free.pco-claim.claimdrain \"k:x\")"] })
(env-chain-data { "gas-price": 0.0000001, "gas-limit": 3000 })
(expect-failure "trailing-space token boundary holds" "not a sponsored call"
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.0000001)))
(rollback-tx)

(begin-tx "GAS_PAYER: vote / propose / transfer are NOT sponsored (claim-only)")
(env-chain-data { "gas-price": 0.0000001, "gas-limit": 3000 })
(env-data { "tx-type": "exec", "exec-code": ["(free.pco.cast-vote \"1\" \"k:x\" \"yes\")"] })
(expect-failure "vote unsponsored" "not a sponsored call"
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.0000001)))
(env-data { "tx-type": "exec", "exec-code": ["(free.pco.create-proposal \"t\" \"b\" [\"a\" \"b\"] 72)"] })
(expect-failure "propose unsponsored" "not a sponsored call"
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.0000001)))
(env-data { "tx-type": "exec", "exec-code": ["(free.pco.transfer \"k:x\" \"k:y\" 1.0)"] })
(expect-failure "transfer unsponsored" "not a sponsored call"
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.0000001)))
(env-data { "tx-type": "exec", "exec-code": ["(free.pco.transfer-crosschain \"k:x\" \"k:x\" g \"1\" 1.0)"] })
(expect-failure "transfer-crosschain unsponsored" "not a sponsored call"
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.0000001)))
(rollback-tx)

(begin-tx "GAS_PAYER: price above ceiling refused (on the sponsored claim)")
(env-data { "tx-type": "exec", "exec-code": ["(free.pco-claim.claim \"r1\" \"k:x\" g \"c\")"] })
(env-chain-data { "gas-price": 0.000001, "gas-limit": 3000 })
(expect-failure "gas price ceiling" "gas price must be <="
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.000001)))
(rollback-tx)

(begin-tx "GAS_PAYER: limit above ceiling refused (on the sponsored claim)")
(env-data { "tx-type": "exec", "exec-code": ["(free.pco-claim.claim \"r1\" \"k:x\" g \"c\")"] })
(env-chain-data { "gas-price": 0.0000001, "gas-limit": 150000 })
(expect-failure "gas limit ceiling" "gas limit must be <="
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 150000 0.0000001)))
(rollback-tx)

(begin-tx "GAS_PAYER: missing injected fields fail closed")
(env-data { "unrelated": true })
(env-chain-data { "gas-price": 0.0000001, "gas-limit": 3000 })
(expect-failure "no tx-type => no sponsorship" "read-msg failure"
  (test-capability (free.pco-gas-station.GAS_PAYER "x" 3000 0.0000001)))
(rollback-tx)

(begin-tx "station guard: outsider with neither branch rejected")
(env-keys ["outsider-key"])
(expect-failure "neither gas-buy nor admin" "station guard"
  (enforce-guard (free.pco-gas-station.create-gas-payer-guard)))
(rollback-tx)

(begin-tx "withdraw: foreign key cannot recover station funds")
(env-data { "att": { "keys": ["att-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "att-key"
            , "caps": [(coin.TRANSFER (free.pco-gas-station.station-account) "att-sink" 1.0)] } ])
(expect-failure "station guard blocks a foreign withdraw" "station guard"
  (free.pco-gas-station.withdraw "att-sink" 1.0))
(rollback-tx)

(begin-tx "withdraw: admin cannot pull more than the station holds")
(env-data { "ops": { "keys": ["ops-key"], "pred": "keys-all" } })
(coin.create-account "ops-sink" (read-keyset 'ops))
(env-sigs [ { "key": "ledger-a"
            , "caps": [(coin.TRANSFER (free.pco-gas-station.station-account) "ops-sink" 999.0)] }
          , { "key": "ledger-b"
            , "caps": [(coin.TRANSFER (free.pco-gas-station.station-account) "ops-sink" 999.0)] } ])
(expect-failure "cannot overdraw the station" "Insufficient funds"
  (free.pco-gas-station.withdraw "ops-sink" 999.0))
(rollback-tx)

(begin-tx "registry-admin/init: station init is one-shot (second create fails)")
(env-keys ["ledger-a", "ledger-b"])
(expect-failure "station init is one-shot" "already found"
  (free.pco-gas-station.init))
(rollback-tx)

;; ===========================================================================
;; Mutation survivors from the 2026-07-29 audit. Each block below corresponds to
;; a mutant that survived all 16 checks, i.e. a defence the suite could not tell
;; was there.
;; ===========================================================================

;; --- C3: `transfer` must FAIL for a receiver that does not exist ------------
;; fungible-v2 REQUIRES it: `transfer` credits an EXISTING account and
;; `transfer-create` is the one that may create. The distinction is carried by a
;; single `with-read` in the delegation path, and changing it to
;; `with-default-read` survived every check - at which point `transfer` would
;; silently create the receiver under the SENDER's guard, because that is the
;; default it would fall back to. Anyone could then plant a balance in an account
;; whose name they chose and whose guard they control.
(begin-tx "C3: transfer (not transfer-create) to a nonexistent receiver is refused")
(env-sigs [ { "key": "whale-key"
            , "caps": [(free.pco.TRANSFER "whale" "ghost-receiver" 1.0)] } ])
(expect-failure "transfer refuses a receiver that does not exist"
  "No value found in table free.pco_accounts for key: ghost-receiver"
  (free.pco.transfer "whale" "ghost-receiver" 1.0))
(rollback-tx)

(begin-tx "C3b: and it still refuses one after a failed attempt")
(expect-failure "no row was created by the refusal"
  "No value found in table free.pco_accounts for key: ghost-receiver"
  (free.pco.get-balance "ghost-receiver"))
(rollback-tx)

;; --- C4: transfer-create must validate the RECEIVER's name ------------------
;; Deleting `(validate-account receiver)` from transfer-create survived every
;; check: receivers named "", "a" and a non-Latin-1 string were all credited.
;; A name that no wallet can render, or a 1-character name, is a permanent
;; unusable balance - and on the cross-chain path an unrenderable receiver is
;; how a credit dies with no rollback.
(begin-tx "C4: transfer-create refuses an EMPTY receiver name")
(env-data { "gg": { "keys": ["gg-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER "whale" "" 1.0)] } ])
(expect-failure "empty receiver name refused" "min length"
  (free.pco.transfer-create "whale" "" (read-keyset 'gg) 1.0))
(rollback-tx)

(begin-tx "C4b: transfer-create refuses a receiver name below the minimum")
(env-data { "gg": { "keys": ["gg-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER "whale" "a" 1.0)] } ])
(expect-failure "1-character receiver refused" "min length"
  (free.pco.transfer-create "whale" "a" (read-keyset 'gg) 1.0))
(rollback-tx)

(begin-tx "C4c: transfer-create refuses a receiver name above the maximum")
(env-data { "gg": { "keys": ["gg-key"], "pred": "keys-all" } })
(let ((long (fold (lambda (acc:string i:integer) (+ acc "x")) "" (enumerate 1 257))))
  (env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER "whale" long 1.0)] } ])
  (expect "the name really is over the 256 bound" 257 (length long))
  (expect-failure "over-long receiver refused" "max length"
    (free.pco.transfer-create "whale" long (read-keyset 'gg) 1.0)))
(rollback-tx)

(begin-tx "C4d: transfer-create refuses a NON-LATIN-1 receiver name")
(env-data { "gg": { "keys": ["gg-key"], "pred": "keys-all" } })
;; built via base64-decode so this file stays plain ASCII
(let ((snowman (+ "snow-" (base64-decode "4piD"))))
  (env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER "whale" snowman 1.0)] } ])
  (expect-failure "non-latin1 receiver refused" "does not conform to the token contract charset"
    (free.pco.transfer-create "whale" snowman (read-keyset 'gg) 1.0)))
(rollback-tx)

;; --- C2: a NEW account opens at ZERO ---------------------------------------
;; Changing create-account's opening balance from 0.0 to 1.0 survived every
;; check. Two unsigned calls then made 2.0 PCO out of nothing, and because
;; `chain-minted` reads the supply row rather than summing balances, the forgery
;; was invisible to it. Nothing asserted the opening balance at all.
(begin-tx "C2: a newly created account opens at exactly zero")
(env-data { "fresh": { "keys": ["fresh-key"], "pred": "keys-all" } })
(env-sigs [])
(free.pco.create-account "fresh-account" (read-keyset 'fresh))
(expect "a new account holds nothing" 0.0
  (free.pco.get-balance "fresh-account"))
(rollback-tx)

(begin-tx "C2b: creating accounts cannot move the supply")
(env-data { "f1": { "keys": ["f1-key"], "pred": "keys-all" }
          , "f2": { "keys": ["f2-key"], "pred": "keys-all" } })
(env-sigs [])
(let ((before (free.pco.chain-minted)))
  (free.pco.create-account "opened-one" (read-keyset 'f1))
  (free.pco.create-account "opened-two" (read-keyset 'f2))
  (expect "both opened at zero" 0.0
    (+ (free.pco.get-balance "opened-one") (free.pco.get-balance "opened-two")))
  (expect "and chain-minted did not move" before (free.pco.chain-minted)))
(rollback-tx)

;; --- C5: grant-internal is gated ONLY by require-capability (OPS) -----------
;; Deleting that one line survived all 16 checks. It is the whole gate: Pact has
;; no private functions, so `grant-internal` is a public entry point that moves
;; tokens OUT OF THE COMMUNITY POOL. Without the require-capability any caller
;; could award themselves up to MAX-GRANT per call, from a pool holding ~900,000
;; PCO, with no signature at all.
;;
;; `require-capability` CHECKS scope rather than acquiring, so a caller who never
;; obtained OPS is refused here — which is exactly what must be asserted, because
;; nothing else in the function does it.
(begin-tx "C5: grant-internal is refused without OPS in scope")
(env-data { "thief": { "keys": ["thief-key"], "pred": "keys-all" } })
(env-sigs [])
(expect-failure "an unsigned caller cannot reach grant-internal"
  "require-capability"
  (free.pco-claim.grant-internal "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    (read-keyset 'thief) 2000.0 "self-award"))
(rollback-tx)

(begin-tx "C5b: and not even with the pool's own guard signed")
;; the pool is module-guarded, so no key satisfies it; this asserts that holding
;; keys is not the missing ingredient - the capability is.
(env-data { "thief": { "keys": ["thief-key"], "pred": "keys-all" } })
(env-keys ["thief-key", "ledger-a", "ledger-b"])
(expect-failure "even the governance pair must go through grant, not grant-internal"
  "require-capability"
  (free.pco-claim.grant-internal "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    (read-keyset 'thief) 2000.0 "self-award"))
(rollback-tx)

(begin-tx "C5c: the POSITIVE control - the sanctioned path still works")
;; Without this, C5/C5b would still pass if grant-internal were broken outright,
;; and the refusals would prove nothing about the capability.
(env-data { "ok-recv": { "keys": ["cafebabe00000000000000000000000000000000000000000000000000000001"], "pred": "keys-all" } })
(env-keys ["ledger-a"])
(expect "the ops tier can still award through the public grant"
  "granted"
  (free.pco-claim.grant "k:cafebabe00000000000000000000000000000000000000000000000000000001"
    (read-keyset 'ok-recv) 10.0 "sanctioned award, positive control"))
(rollback-tx)

(print "negatives.repl: ALL NEGATIVE CASES FAILED AS EXPECTED")
