      { "account": "k:c0ffee000000000000000000000000000000000000000000000000000c0ffee0"
      , "guard": (read-keyset 'cl), "amount": 1.0, "reason": "x" })))
(expect-failure "duplicate receiver (install identity ignores amount)" "already installed"
  (free.pco-claim.grant-batch
    [ { "account": "k:c0ffee000000000000000000000000000000000000000000000000000c0ffee0"
      , "guard": (read-keyset 'cl), "amount": 1.0, "reason": "x" }
    , { "account": "k:c0ffee000000000000000000000000000000000000000000000000000c0ffee0"
      , "guard": (read-keyset 'cl), "amount": 2.0, "reason": "y" } ]))
