;; negatives.repl — exhaustive "the wrong thing fails" suite.
;;
;; The per-module suites (pco.repl / pco-claim.repl / pco-gas-station.repl)
;; cover the headline negatives inline. THIS file is the completeness sweep:
;; one deployed + minted world, then every remaining enforce / guard / bound
;; branch in all three modules exercised as a FAILURE with its exact error
;; substring — so that "doing the wrong thing fails as expected" is proven
;; branch by branch before mainnet.
;;
;; REPL discipline: expect-failure does NOT roll back partial writes and
;; commit-tx would persist the leak, so every write-capable negative lives in
;; its own tx ended by (rollback-tx). Error substrings match the REPL Pretty
;; column (on-chain BoundedText differs — see pact-traps).

(env-exec-config ["RequireKeysetNs"])
(env-chain-data { "chain-id": "0", "block-time": (time "2026-08-01T00:00:00Z") })

;; ---------------------------------------------------------------------------
;; Shared world: interfaces + coin + namespace + keyset + all 3 modules + mint
;; ---------------------------------------------------------------------------
(begin-tx "interfaces + coin")
(load "fixtures/fungible-v2.pact")
(load "fixtures/fungible-xchain-v1.pact")
(load "fixtures/gas-payer-v1.pact")
(load "fixtures/coin-v5.pact")
(create-table coin.coin-table)
(create-table coin.allocation-table)
(commit-tx)

(begin-tx "deploy all three modules")
(env-data
  { "ns": "free"
  , "upgrade": false
  , "symbol": "PCO", "precision": 12, "total-supply": 1000000.0
  , "gov-threshold": 0.001
  , "pco-gov":  { "keys": ["ledger-a", "ledger-b", "ledger-c"], "pred": "keys-2" }
  , "pco-ops":  { "keys": ["ledger-a"], "pred": "keys-all" }
  , "ns-guard": { "keys": ["ledger-a", "ledger-b", "ledger-c"], "pred": "keys-2" } })
(env-keys ["ledger-a", "ledger-b"])
(define-namespace "free" (read-keyset 'ns-guard) (read-keyset 'ns-guard))
(namespace "free")
(define-keyset "free.pco-gov" (read-keyset 'pco-gov))
(load "../contracts/pco.pact")
(load "../contracts/pco-claim.pact")
(load "../contracts/pco-gas-station.pact")
(commit-tx)

(begin-tx "governance names the ops authority")
(env-keys ["ledger-a", "ledger-b"])
(free.pco.set-ops-guard (read-keyset 'pco-ops))
(commit-tx)

(begin-tx "mint: whale + holder + claim pool + reserve")
(env-data
  { "whale":  { "keys": ["whale-key"],  "pred": "keys-all" }
  , "holder": { "keys": ["holder-key"], "pred": "keys-all" } })
(env-keys ["ledger-a", "ledger-c"])
(free.pco.init-mint
  [ { "account": "whale",  "guard": (read-keyset 'whale),  "amount": 600000.0 }
  , { "account": "holder", "guard": (read-keyset 'holder), "amount": 200000.0 }
  , { "account": (free.pco-claim.pool-account), "guard": (free.pco-claim.pool-guard), "amount": 100000.0 }
  , { "account": "r:free.pco-gov", "guard": (keyset-ref-guard "free.pco-gov"), "amount": 100000.0 } ])
(commit-tx)

;; ===========================================================================
;; MODULE `pco` — TOKEN CORE
;; ===========================================================================

;; --- managed TRANSFER cap invariants (run in the cap body before any move) ---
(begin-tx "transfer: sender == receiver rejected")
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER "whale" "whale" 1.0)] } ])
(expect-failure "same sender and receiver" "same sender and receiver"
  (free.pco.transfer "whale" "whale" 1.0))
(rollback-tx)

(begin-tx "transfer: non-positive amount rejected")
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER "whale" "holder" 0.0)] } ])
(expect-failure "amount must be positive" "amount must be positive"
  (free.pco.transfer "whale" "holder" 0.0))
(rollback-tx)

(begin-tx "transfer: over-precise amount rejected (enforce-unit)")
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER "whale" "holder" 1.0)] } ])
(expect-failure "precision violation" "precision violation"
  (free.pco.transfer "whale" "holder" 1.0000000000001))
(rollback-tx)

(begin-tx "transfer: insufficient funds rejected")
(env-data { "sink": { "keys": ["sink-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "holder-key", "caps": [(free.pco.TRANSFER "holder" "sink" 999999.0)] } ])
(expect-failure "insufficient funds" "insufficient funds"
  (free.pco.transfer-create "holder" "sink" (read-keyset 'sink) 999999.0))
(rollback-tx)

(begin-tx "transfer: no signature at all (managed cap never installed)")
(env-sigs [])
(expect-failure "unsigned transfer rejected before any move" "Managed capability not installed"
  (free.pco.transfer "whale" "holder" 1.0))
(rollback-tx)

;; --- credit-side guard binding (transfer-create to an existing account with a
;;     DIFFERENT guard must not silently rebind it) ---
(begin-tx "transfer-create: guard mismatch on an existing account")
(env-data { "wrong": { "keys": ["someone-else"], "pred": "keys-all" } })
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER "whale" "holder" 1.0)] } ])
(expect-failure "credit to existing acct with wrong guard rejected" "account guard mismatch"
  (free.pco.transfer-create "whale" "holder" (read-keyset 'wrong) 1.0))
(rollback-tx)

;; --- account-name protocol (validate-account + enforce-reserved) ---
(begin-tx "create-account: name too short")
(env-data { "g": { "keys": ["gk"], "pred": "keys-all" } })
(expect-failure "min length enforced" "min length"
  (free.pco.create-account "ab" (read-keyset 'g)))
(rollback-tx)

(begin-tx "create-account: non-latin1 charset rejected")
(env-data { "g": { "keys": ["gk"], "pred": "keys-all" } })
;; a snowman (U+2603, base64 "4piD") is outside latin-1 (CHARSET_LATIN1) so
;; it trips is-charset. Built via base64-decode to avoid source-literal escapes.
(expect-failure "charset enforced" "does not conform to the token contract charset"
  (free.pco.create-account (+ "snow-" (base64-decode "4piD")) (read-keyset 'g)))
(rollback-tx)

(begin-tx "create-account: k: squatting (single-key protocol) rejected")
(env-data { "foreign": { "keys": ["not-the-principal"], "pred": "keys-all" } })
(expect-failure "k: must be the principal of its guard" "Single-key account protocol violation"
  (free.pco.create-account
    "k:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
    (read-keyset 'foreign)))
(rollback-tx)

(begin-tx "create-account: w: reserved protocol rejected under a foreign guard")
(env-data { "foreign": { "keys": ["k1", "k2"], "pred": "keys-all" } })
(expect-failure "w: reserved protocol violation" "Reserved protocol guard violation"
  (free.pco.create-account
    "w:mismatchmismatchmismatchmismatchmismatchmis:keys-all"
    (read-keyset 'foreign)))
(rollback-tx)

;; --- rotate: principal accounts may not escape their proper guard ---
(begin-tx "rotate: principal account cannot rotate to a foreign guard")
(env-data
  { "kacct": { "keys": ["cafe0000000000000000000000000000000000000000000000000000cafe0000"], "pred": "keys-all" }
  , "other": { "keys": ["deadbeef0000000000000000000000000000000000000000000000000000dead"], "pred": "keys-all" } })
(env-sigs [ { "key": "whale-key"
            , "caps": [(free.pco.TRANSFER "whale" "k:cafe0000000000000000000000000000000000000000000000000000cafe0000" 1.0)] } ])
(free.pco.transfer-create "whale"
  "k:cafe0000000000000000000000000000000000000000000000000000cafe0000" (read-keyset 'kacct) 1.0)
(env-sigs [ { "key": "cafe0000000000000000000000000000000000000000000000000000cafe0000"
            , "caps": [(free.pco.ROTATE "k:cafe0000000000000000000000000000000000000000000000000000cafe0000" (create-principal (read-keyset 'other)))] } ])
(expect-failure "principal cannot rotate away from its guard" "unsafe for principal accounts"
  (free.pco.rotate "k:cafe0000000000000000000000000000000000000000000000000000cafe0000" (read-keyset 'other)))
(rollback-tx)

(begin-tx "rotate: foreign key cannot rotate someone else's account")
(env-data { "new": { "keys": ["new-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "someone-else", "caps": [(free.pco.ROTATE "whale" (create-principal (read-keyset 'new)))] } ])
(expect-failure "rotate needs the account's own guard" "Keyset failure"
  (free.pco.rotate "whale" (read-keyset 'new)))
(rollback-tx)

;; --- ops authority (governance-owned; ops can never re-point itself) ---
(begin-tx "ops authority: the ops key cannot name its successor")
(env-data { "hijack": { "keys": ["ledger-a"], "pred": "keys-all" } })
(env-keys ["ledger-a"])                      ; the CURRENT ops authority, alone
(expect-failure "ops cannot set the ops guard" "Keyset failure"
  (free.pco.set-ops-guard (read-keyset 'hijack)))
(rollback-tx)

(begin-tx "ops authority: a holder cannot set it either")
(env-data { "hijack": { "keys": ["whale-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "whale-key", "caps": [] } ])
(expect-failure "a holder cannot set the ops guard" "Keyset failure"
  (free.pco.set-ops-guard (read-keyset 'hijack)))
(rollback-tx)

(begin-tx "ops authority: a single governance key is not enough (2-of-3)")
(env-data { "newops": { "keys": ["ledger-x"], "pred": "keys-all" } })
(env-keys ["ledger-b"])
(expect-failure "one gov key cannot set the ops guard" "Keyset failure"
  (free.pco.set-ops-guard (read-keyset 'newops)))
(rollback-tx)

;; --- vote key (the hot key can ONLY vote; registration is main-guard-only) ---
(begin-tx "vote key: the hot key cannot register or re-point itself")
(env-data { "vk": { "keys": ["hot-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "hot-key", "caps": [(free.pco.VOTE-KEY-ADMIN "whale" (create-principal (read-keyset 'vk)))] } ])
(expect-failure "registration needs the MAIN guard" "Keyset failure"
  (free.pco.set-vote-key "whale" (read-keyset 'vk)))
(rollback-tx)

(begin-tx "vote key: registering for a nonexistent account fails")
(env-data { "vk": { "keys": ["hot-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "hot-key", "caps": [(free.pco.VOTE-KEY-ADMIN "ghost" (create-principal (read-keyset 'vk)))] } ])
(expect-failure "no such account row" "No value found"
  (free.pco.set-vote-key "ghost" (read-keyset 'vk)))
(rollback-tx)

(begin-tx "vote key: clearing without a registration fails")
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.VOTE-KEY-ADMIN "whale" "")] } ])
(expect-failure "no prior registration to clear" "No row found during update"
  (free.pco.clear-vote-key "whale"))
(rollback-tx)

(begin-tx "vote key: a cleared (inactive) hot key cannot vote")
(env-keys ["ledger-a"])
(free.pco.create-proposal "the vote" "b" ["a" "b"] 72)
(env-data { "vk": { "keys": ["hot-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.VOTE-KEY-ADMIN "whale" (create-principal (read-keyset 'vk))), (free.pco.VOTE-KEY-ADMIN "whale" "")] } ])
(free.pco.set-vote-key "whale" (read-keyset 'vk))
(free.pco.clear-vote-key "whale")
(env-sigs [ { "key": "hot-key", "caps": [(free.pco.VOTE "1" "whale")] } ])
(expect-failure "cleared key refused"
  "neither account guard nor registered vote key satisfied"
  (free.pco.cast-vote "1" "whale" [0]))
(rollback-tx)

(begin-tx "vote key: an active hot key has NO power beyond voting")
(env-data { "vk":  { "keys": ["hot-key"], "pred": "keys-all" }
          , "new": { "keys": ["hot-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.VOTE-KEY-ADMIN "whale" (create-principal (read-keyset 'vk)))] } ])
(free.pco.set-vote-key "whale" (read-keyset 'vk))
(env-sigs [ { "key": "hot-key", "caps": [(free.pco.TRANSFER "whale" "holder" 1.0)] } ])
(expect-failure "hot key cannot transfer" "Keyset failure"
  (free.pco.transfer "whale" "holder" 1.0))
(env-sigs [ { "key": "hot-key", "caps": [(free.pco.ROTATE "whale" (create-principal (read-keyset 'new)))] } ])
(expect-failure "hot key cannot rotate" "Keyset failure"
  (free.pco.rotate "whale" (read-keyset 'new)))
(env-sigs [ { "key": "hot-key", "caps": [] } ])
(expect-failure "hot key cannot open a proposal (admin-authored)"
  "governance or ops authority required"
  (free.pco.create-proposal "t" "b" ["a" "b"] 72))
(env-sigs [ { "key": "hot-key", "caps": [(free.pco.VOTE-KEY-ADMIN "whale" "")] } ])
(expect-failure "hot key cannot clear the registration" "Keyset failure"
  (free.pco.clear-vote-key "whale"))
(rollback-tx)

;; --- cross-chain (cap-body invariants; SPV resume is devnet-only) ---
(env-data { "whale": { "keys": ["whale-key"], "pred": "keys-all" } })
(begin-tx "xchain: non-positive amount rejected")
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER_XCHAIN "whale" "whale" 0.0 "1")] } ])
(expect-failure "xchain amount must be positive" "cross-chain amount must be positive"
  (free.pco.transfer-crosschain "whale" "whale" (read-keyset 'whale) "1" 0.0))
(rollback-tx)

(begin-tx "xchain: over-precise amount rejected")
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER_XCHAIN "whale" "whale" 1.0 "1")] } ])
(expect-failure "xchain precision enforced" "precision violation"
  (free.pco.transfer-crosschain "whale" "whale" (read-keyset 'whale) "1" 1.0000000000001))
(rollback-tx)

(begin-tx "xchain: nonexistent target chain rejected (audit M-1)")
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER_XCHAIN "whale" "whale" 1.0 "20")] } ])
(expect-failure "chain 20 does not exist" "not a valid chain id"
  (free.pco.transfer-crosschain "whale" "whale" (read-keyset 'whale) "20" 1.0))
(rollback-tx)

(begin-tx "xchain: same-chain target rejected")
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER_XCHAIN "whale" "whale" 1.0 "0")] } ])
(expect-failure "cannot xchain to the current chain" "same chain"
  (free.pco.transfer-crosschain "whale" "whale" (read-keyset 'whale) "0" 1.0))
(rollback-tx)

;; ===========================================================================
;; MODULE `pco` — GOVERNANCE
;; ===========================================================================

(begin-tx "propose: only the org can propose (community goes via the public channels)")
(env-sigs [ { "key": "whale-key", "caps": [] } ])
(expect-failure "a token holder cannot create on-chain proposals"
  "governance or ops authority required"
  (free.pco.create-proposal "t" "b" ["a" "b"] 72))
(env-keys ["ledger-b"])
(expect-failure "a single NON-ops governance key fails both branches"
  "governance or ops authority required"
  (free.pco.create-proposal "t" "b" ["a" "b"] 72))
(rollback-tx)

(begin-tx "propose: duration below the minimum rejected")
(env-keys ["ledger-a"])
(expect-failure "duration < 24h" "duration outside"
  (free.pco.create-proposal "t" "b" ["a" "b"] 23))
(rollback-tx)

(begin-tx "propose: duration above the maximum rejected")
(env-keys ["ledger-a"])
(expect-failure "duration > 720h" "duration outside"
  (free.pco.create-proposal "t" "b" ["a" "b"] 721))
(rollback-tx)

(begin-tx "propose: empty title rejected")
(env-keys ["ledger-a"])
(expect-failure "empty title" "title 1..120"
  (free.pco.create-proposal "" "b" ["a" "b"] 72))
(rollback-tx)

(begin-tx "propose: over-long title rejected")
(env-keys ["ledger-a"])
(expect-failure "title > 120 chars"  "title 1..120"
  (free.pco.create-proposal
    "0123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890123456789012345678901234567890X"
    "b" ["a" "b"] 72))
(rollback-tx)

(begin-tx "propose: option-list bounds enforced")
(env-keys ["ledger-a"])
(expect-failure "one option is not a question" "2..5 options required"
  (free.pco.create-proposal "t" "b" ["only"] 72))
(expect-failure "more than MAX-OPTIONS refused" "2..5 options required"
  (free.pco.create-proposal "t" "b" ["a" "b" "c" "d" "e" "f"] 72))
(expect-failure "duplicate options refused" "options must be distinct"
  (free.pco.create-proposal "t" "b" ["a" "a"] 72))
(expect-failure "empty option label refused" "each option 1..60 chars"
  (free.pco.create-proposal "t" "b" ["a" ""] 72))
(expect-failure "over-long option label refused" "each option 1..60 chars"
  (free.pco.create-proposal "t" "b"
    ["a" "0123456789012345678901234567890123456789012345678901234567890"] 72))
(rollback-tx)

(begin-tx "propose: off-hub rejected")
(env-chain-data { "chain-id": "4" })
(env-keys ["ledger-a"])
(expect-failure "governance is hub-only" "hub chain only"
  (free.pco.create-proposal "t" "b" ["a" "b"] 72))
(rollback-tx)
(env-chain-data { "chain-id": "0" })

;; MAX-ACTIVE-PROPOSALS: open 3, the 4th must fail
(begin-tx "propose: 3 open then the 4th refused")
(env-keys ["ledger-a"])
(free.pco.create-proposal "p1" "b" ["a" "b"] 72)
(free.pco.create-proposal "p2" "b" ["a" "b"] 72)
(free.pco.create-proposal "p3" "b" ["a" "b"] 72)
(expect-failure "4th proposal refused" "too many active proposals"
  (free.pco.create-proposal "p4" "b" ["a" "b"] 72))
(rollback-tx)

;; --- admin-cancel: the accountable early close ---
(begin-tx "cancel: reason mandatory, authorization enforced, close is final")
(env-keys ["ledger-a"])
(free.pco.create-proposal "to-cancel" "b" ["a" "b"] 72)
(env-sigs [ { "key": "whale-key", "caps": [] } ])
(expect-failure "a holder cannot cancel" "governance or ops authority required"
  (free.pco.admin-cancel-proposal "1" "r"))
(env-keys ["ledger-a"])
(expect-failure "a public reason is mandatory" "public reason is required"
  (free.pco.admin-cancel-proposal "1" ""))
(expect-failure "reason length bounded (audit F2)" "public reason is required"
  (free.pco.admin-cancel-proposal "1"
    (fold (+) "" (make-list 300 "0123456789"))))
(expect "ops cancels with a public reason" "cancelled"
  (free.pco.admin-cancel-proposal "1" "duplicate of question 7 on the channels"))
(expect "slot freed immediately" [] (free.pco.open-ids))
(expect-failure "cannot cancel an already-closed proposal" "proposal already closed"
  (free.pco.admin-cancel-proposal "1" "again"))
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.VOTE "1" "whale")] } ])
(expect-failure "no votes after a cancel" "voting closed"
  (free.pco.cast-vote "1" "whale" [0]))
(rollback-tx)

;; vote negatives (open a proposal in-tx, then attack it)
(begin-tx "vote negatives")
(env-keys ["ledger-a"])
(expect "proposal opens" "1" (free.pco.create-proposal "the vote" "b" ["a" "b" "c"] 72))

(env-sigs [ { "key": "whale-key", "caps": [(free.pco.VOTE "1" "whale")] } ])
(expect-failure "empty ranking rejected" "ranking: 1..K entries"
  (free.pco.cast-vote "1" "whale" []))
(expect-failure "over-long ranking rejected" "ranking: 1..K entries"
  (free.pco.cast-vote "1" "whale" [0 1 2 0]))
(expect-failure "duplicate ranking entries rejected" "ranking entries must be distinct"
  (free.pco.cast-vote "1" "whale" [0 0]))
(expect-failure "out-of-range option index rejected" "ranking entry out of range"
  (free.pco.cast-vote "1" "whale" [3]))
(expect-failure "negative option index rejected" "ranking entry out of range"
  (free.pco.cast-vote "1" "whale" [-1]))

(env-sigs [ { "key": "someone-else", "caps": [(free.pco.VOTE "1" "whale")] } ])
(expect-failure "foreign key cannot vote as whale"
  "neither account guard nor registered vote key satisfied"
  (free.pco.cast-vote "1" "whale" [0]))

(env-keys ["ledger-a", "ledger-b"])
(expect-failure "reserve barred from voting" "reserve cannot vote"
  (free.pco.cast-vote "1" "r:free.pco-gov" [0]))

;; zero-weight voter (a real account with no balance)
(env-data { "empty": { "keys": ["empty-key"], "pred": "keys-all" } })
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.TRANSFER "whale" "empty" 1.0)] } ])
(free.pco.transfer-create "whale" "empty" (read-keyset 'empty) 1.0)
(env-sigs [ { "key": "empty-key", "caps": [(free.pco.TRANSFER "empty" "whale" 1.0)] } ])
(free.pco.transfer "empty" "whale" 1.0)   ; drain to 0
(env-sigs [ { "key": "empty-key", "caps": [(free.pco.VOTE "1" "empty")] } ])
(expect-failure "zero balance has no voting weight" "no voting weight"
  (free.pco.cast-vote "1" "empty" [0]))

;; vote off-hub
(env-chain-data { "chain-id": "2" })
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.VOTE "1" "whale")] } ])
(expect-failure "voting is hub-only" "hub chain only"
  (free.pco.cast-vote "1" "whale" [0]))
(env-chain-data { "chain-id": "0" })

;; vote after close
(env-chain-data { "block-time": (time "2026-08-05T00:00:01Z") })   ; > 72h
(env-sigs [ { "key": "whale-key", "caps": [(free.pco.VOTE "1" "whale")] } ])
(expect-failure "no votes after close" "voting closed"
  (free.pco.cast-vote "1" "whale" [0]))
(rollback-tx)
(env-chain-data { "block-time": (time "2026-08-01T00:00:00Z") })

;; ===========================================================================
;; MODULE `pco-claim` (v2: rounds + grants)
;; ===========================================================================

;; TIER SPLIT: ledger-a is the OPS key (free.pco-ops, keys-all over 1) and
;; MAY solo-run round ops / grants / set-open. The negatives below therefore
;; probe a single NON-ops governance key, a foreign key, and the boundary:
;; the ops key must hold NOTHING above the routine tier.

;; --- create-round: authorization ---
(begin-tx "create-round: single NON-ops governance key insufficient")
(env-keys ["ledger-b"])
(expect-failure "1 non-ops key fails both OPS branches" "ops authorization failed"
  (free.pco-claim.create-round "r-auth" (hash "q") 100.0 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(rollback-tx)

(begin-tx "create-round: foreign key insufficient")
(env-keys ["attacker-key"])
(expect-failure "foreign key fails both OPS branches" "ops authorization failed"
  (free.pco-claim.create-round "r-auth" (hash "q") 100.0 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(rollback-tx)

;; --- create-round: every bound, one by one ---
(begin-tx "create-round: bound sweep")
(env-keys ["ledger-a"])
(expect-failure "empty code hash" "empty code hash"
  (free.pco-claim.create-round "r-bnd" "" 100.0 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "zero amount" "amount must be positive"
  (free.pco-claim.create-round "r-bnd" (hash "q") 0.0 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "negative amount" "amount must be positive"
  (free.pco-claim.create-round "r-bnd" (hash "q") -1.0 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "over-precise amount" "respect the token's precision"
  (free.pco-claim.create-round "r-bnd" (hash "q") 1.0000000000001 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "amount above MAX-ROUND-AMOUNT" "exceeds the per-claim bound"
  (free.pco-claim.create-round "r-bnd" (hash "q") 500.000000000001 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "budget below one claim" "budget must cover at least one claim"
  (free.pco-claim.create-round "r-bnd" (hash "q") 100.0 99.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "over-precise budget" "respect the token's precision"
  (free.pco-claim.create-round "r-bnd" (hash "q") 100.0 1000.0000000000001
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "budget above MAX-ROUND-BUDGET" "exceeds the per-round bound"
  (free.pco-claim.create-round "r-bnd" (hash "q") 100.0 30000.000000000001
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "closes == opens" "closes must be after opens"
  (free.pco-claim.create-round "r-bnd" (hash "q") 100.0 1000.0
    (time "2026-08-08T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "closes before opens" "closes must be after opens"
  (free.pco-claim.create-round "r-bnd" (hash "q") 100.0 1000.0
    (time "2026-08-08T00:00:00Z") (time "2026-08-01T00:00:00Z")))
(expect-failure "round id too short" "round id must be 3-64 characters"
  (free.pco-claim.create-round "r" (hash "q") 100.0 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "round id too long" "round id must be 3-64 characters"
  (free.pco-claim.create-round
    "rrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrrr"
    (hash "q") 100.0 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "round id with the key separator" "must not contain"
  (free.pco-claim.create-round "bad|id" (hash "q") 100.0 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(expect-failure "non-ASCII round id" "round id must be ASCII"
  (free.pco-claim.create-round "ronda-ñ" (hash "q") 100.0 1000.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(rollback-tx)

;; --- create-round: the daily ops meter fails closed ---
(begin-tx "create-round: ops daily cap reached")
(env-keys ["ledger-a"])
(free.pco-claim.create-round "cap-1" (hash "q1") 500.0 30000.0
  (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z"))
(free.pco-claim.create-round "cap-2" (hash "q2") 500.0 10000.0
  (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z"))
(expect-failure "40k committed - the next budget breaks the cap" "ops daily cap reached"
  (free.pco-claim.create-round "cap-3" (hash "q3") 100.0 100.0
    (time "2026-08-01T00:00:00Z") (time "2026-08-08T00:00:00Z")))
(rollback-tx)


;; ---------------------------------------------------------------------------
;; GAP CLOSURE (mutation audit 2026-07-29) — each case below kills a mutant that
;; previously survived the whole suite. They are authorization and protocol
;; checks whose deletion changed no observable behaviour in any existing test.
;; ---------------------------------------------------------------------------

;; M-VOTE: cast-vote-internal is PUBLIC and its ONLY authorization is the
;; require-capability. Deleting that line let anyone vote as anyone; nothing
;; failed. A caller holding no VOTE capability must be refused.
(begin-tx "cast-vote-internal refuses a caller that does not hold VOTE")
(env-keys [])
(env-sigs [])
(env-keys ["ledger-a"])
(free.pco.create-proposal "gapcheck" "does the gate hold?" ["a" "b"] 72)
(env-keys [])
(env-sigs [])
(expect-failure "the internal ballot writer is not callable without VOTE"
  "not granted"
  (free.pco.cast-vote-internal "1" "whale" [0]))
(rollback-tx)

;; M-INSERT: create-account uses `insert`, which aborts on an existing row. If
;; it were `write`, anyone could overwrite an existing account's GUARD - taking
;; it over - and its balance. `insert` is the whole protection.
(begin-tx "create-account cannot overwrite an existing account")
(env-data { "thief": { "keys": ["thief-key"], "pred": "keys-all" } })
(expect-failure "re-creating an existing account is refused"
  "Value already found while in Insert mode"
  (free.pco.create-account "whale" (read-keyset 'thief)))
(rollback-tx)

;; M-RESERVED: enforce-reserved inside transfer-create. Without it a k: account
;; could be created under a guard that is not its principal - the squatting the
;; create-account path already refuses, reachable by the other door.
(begin-tx "k: squatting via transfer-create is refused")
(env-data { "foreign": { "keys": ["not-the-principal"], "pred": "keys-all" } })
(env-sigs [ { "key": "whale-key"
            , "caps": [(free.pco.TRANSFER "whale"
                        "k:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc" 1.0)] } ])
(expect-failure "transfer-create honours the reserved-name protocol too"
  "Single-key account protocol violation"
  (free.pco.transfer-create "whale"
    "k:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
    (read-keyset 'foreign) 1.0))
(rollback-tx)

;; --- round management on missing rounds ---
(begin-tx "set-round-active/code: missing round fails cleanly")
(env-keys ["ledger-a"])
;; set-round-active writes straight through, so the missing row surfaces from
;; `update`; set-round-code reads the row first (to check the no-claims rule),
;; so it surfaces from `with-read` one step earlier. Both fail closed.
(expect-failure "no such round to pause" "No row found during update in table"
  (free.pco-claim.set-round-active "ghost" false))
(expect-failure "no such round to re-code" "No value found in table"
  (free.pco-claim.set-round-code "ghost" (hash "q")))
(expect-failure "empty replacement hash" "empty code hash"
  (free.pco-claim.set-round-code "ghost" ""))
(rollback-tx)

(begin-tx "set-open: single NON-ops governance key insufficient")
(env-keys ["ledger-c"])
(expect-failure "1 non-ops key cannot open" "ops authorization failed"
  (free.pco-claim.set-open true))
(rollback-tx)

;; --- tier boundaries (unchanged by v2) ---
(begin-tx "tier boundary: ops key alone cannot sweep the pool")
(env-keys ["ledger-a"])
(expect-failure "sweep stays 2-of-3" "Keyset failure"
  (free.pco-claim.sweep-pool "r:free.pco-gov" (keyset-ref-guard "free.pco-gov")))
(rollback-tx)

(begin-tx "tier boundary: ops key alone holds no module admin on any module")
(env-keys ["ledger-a"])
(expect-failure "pco upgrade gate holds" "Keyset failure"
  (acquire-module-admin free.pco))
(expect-failure "pco-claim upgrade gate holds" "Keyset failure"
  (acquire-module-admin free.pco-claim))
(expect-failure "pco-gas-station upgrade gate holds" "Keyset failure"
  (acquire-module-admin free.pco-gas-station))
(rollback-tx)

(begin-tx "tier boundary: ops key alone cannot rotate the GOVERNANCE keyset")
(env-data { "evil-gov": { "keys": ["ledger-a"], "pred": "keys-all" } })
(env-keys ["ledger-a"])
(namespace "free")
(expect-failure "pco-gov redefinition needs the current 2-of-3" "Keyset failure"
  (define-keyset "free.pco-gov" (read-keyset 'evil-gov)))
(rollback-tx)

(begin-tx "tier boundary: ops key alone cannot mint")
(env-keys ["ledger-a"])
(env-data { "x": { "keys": ["xk"], "pred": "keys-all" } })
(expect-failure "MINT stays 2-of-3 (guard fires before the one-shot check)" "Keyset failure"
  (free.pco.init-mint [ { "account": "x-acct", "guard": (read-keyset 'x), "amount": 1000000.0 } ]))
(rollback-tx)

;; --- claim gates ---
