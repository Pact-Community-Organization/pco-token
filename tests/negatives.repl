(free.pco-claim.create-round "quest-a" (hash "quest-1") 100.0 2500.0
  (time "2026-08-01T00:00:00Z") (time "2026-08-15T00:00:00Z"))
(env-keys [])
(env-data { "cl": { "keys": ["c0ffee000000000000000000000000000000000000000000000000000c0ffee0"], "pred": "keys-all" } })
